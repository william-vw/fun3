@prefix list: <http://www.w3.org/2000/10/swap/list#> .

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fh: <http://hl7.org/fhir/>
PREFIX ut: <http://example.org/utils#>
PREFIX zk: <http://example.org/zika#>

# https://www.cdc.gov/zika/hc-providers/testing-guidance.html


{ ?id zk:testForZika true } <= {
    ?p zk:isPregnant true .
    ?p zk:hasZikaSymptom ?symptom .
    ?p zk:possibleZikaExposure true .

    ?p fh:id ?id .
} .

{ ?p zk:isPregnant true } <= {
    ?p a fh:Patient .
    ?p ut:hasCondition ?c .    
    ?c fh:code ?ccode . ?ccode ut:hasCodeValue 77386006 . # (SNOMED) pregnancy
    ?c fh:clinicalStatus ?cstatus . ?cstatus ut:hasCodeValue "active" .
    ?c fh:verificationStatus ?vstatus . ?vstatus ut:hasCodeValue "confirmed" .
} .

{ ?p zk:hasZikaSymptom ?c } <= {
   ?p a fh:Patient .
   ?p ut:hasCondition ?c .
   ?c fh:clinicalStatus ?cstatus . ?cstatus ut:hasCodeValue "active" .
   ?c fh:verificationStatus ?vstatus . ?vstatus ut:hasCodeValue "confirmed" .
   ?c fh:code ?ccode . ?ccode ut:hasCodeValue ?code .
   # https://phinvads.cdc.gov/vads/ViewValueSet.action?oid=2.16.840.1.114222.4.11.7459
   ?code list:in ( 84387000 271749004 47725002 57676002 9826008 68962001 25064002 ) .
} .

{ ?p zk:possibleZikaExposure true } <= {
    ?p zk:recentTravelToZikaArea true
} .

{ ?p zk:possibleZikaExposure true } <= {
    ?p zk:recentSexualEncounterWithZikaResidentOrTraveler true
} .

{ ?p zk:recentTravelToZikaArea true } <= {
    ?p a fh:Patient .

    # http://build.fh.org/ig/HL7/case-reporting/StructureDefinition-us-ph-travel-history.html
    ?p ut:hasObservation ?o . 
    ?o fh:code ?oc . ?oc ut:hasCodeValue 420008001 . # (SNOMED) Travel
   
   ?o fh:country ?country .
   zk:world zk:hasZikaArea ?country .

#    ?o ut:timeSinceObsEnd ?timeSince .
#    FILTER (?timeSince < 2678400000) # 1 month
} .

{ zk:world zk:hasZikaArea ?country } <= {
    ?country list:in ( "American Samoa" "Angola" "Anguilla" "Antigua and Barbuda" "Argentina" "Aruba" "Bahamas" "Bangladesh" "Barbados" "Belize" "Bolivia" "Bonaire" "Brazil" "British Virgin Islands" "Burkina Faso" "Burma" "Burundi" "Cambodia" "Cameroon" "Cape Verde" "Cayman Islands" "Central African Republic" "Colombia" "Cook Islands" "Costa Rica" "Cuba" "Curacao" "Dominica" "Dominican Republic" "Easter Island" "Ecuador" "El Salvador" "Ethiopia" "Federated States of Micronesia" "Fiji" "France" "French Guiana" "French Polynesia" "Gabon" "Grenada" "Guadeloupe" "Guatemala" "Guinea-Bissau" "Guyana" "Haiti" "Honduras" "India" "Indonesia" "Ivory Coast" "Jamaica" "Kenya" "Kiribati" "Laos" "Malaysia" "Maldives" "Marshall Islands" "Martinique" "Mexico" "Montserrat" "New Caledonia" "Nicaragua" "Nigeria" "Palau" "Panama" "Papua New Guinea" "Paraguay" "Peru" "Philippines" "Puerto Rico" "Saba" "Saint Barthelemy" "Saint Kitts and Nevis" "Saint Lucia" "Saint Martin" "Saint Vincent and the Grenadines" "Samoa" "Senegal" "Singapore" "Sint Eustatius" "Sint Maarten" "Solomon Islands" "Suriname" "Thailand" "Tonga" "Trinidad and Tobago" "Turks and Caicos" "Uganda" "United States (Continental US)" "United States Virgin Islands" "Vanuatu" "Venezuela" "Vietnam" ) .
} .

{ ?p zk:residentOfZikaArea true } <= {
    ?p a fh:Patient .
    ?p fh:address ?pa . ?pa fh:country ?country .
    zk:world zk:hasZikaArea ?country .
} .

{ ?p zk:atZikaRiskDueToGeography true } <= {
    ?p zk:recentTravelToZikaArea true
} .

{ ?p zk:atZikaRiskDueToGeography true } <= {
    ?p zk:residentOfZikaArea true
} .

{ ?p zk:recentSexualEncounterWithZikaResidentOrTraveler true } <= {
    ?p ut:hasObservation ?o .

    ?o fh:code ?ocode . ?ocode ut:hasCodeValue 225517006 . # (SNOMED) Sexual partners
    ?p2 ut:referredBy ?o .

    ?p2 zk:atZikaRiskDueToGeography true .

    # ?o ut:timeSinceObsEnd ?timeSince .
    # FILTER (?timeSince < 2678400000) # 1 month
} .

# utilities

{ ?p ut:has ?r } <= {
    ?p fh:id ?id .
    ?r fh:subject ?id .
} .

{ ?r ut:hasCodeValue ?c } <= { 
    ?r fh:coding ?cod . 
    ?cod fh:code ?c 
} .

{ ?p ut:hasCondition ?c } <= {
    ?p ut:has ?c .
    ?c a fh:Condition .
} .

{ ?p ut:hasObservation ?o } <= {
    ?p ut:has ?o .
    ?o a fh:Observation ;
} .

{ ?p ut:referredBy ?r } <= {
    ?p fh:id ?id .
    ?r fh:value ?id
} .